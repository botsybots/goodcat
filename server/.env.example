JWT_SECRET=replace-me-with-a-strong-secret
PORT=3000
VAPID_PUBLIC=
VAPID_PRIVATE=

# Optional: point at a hosted Turso (libSQL) database instead of a local
# SQLite file. Needed for deployments on hosts with an ephemeral filesystem
# (e.g. Render's free tier) so data survives restarts. Leave both blank for
# local development -- falls back to server/data.db automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
